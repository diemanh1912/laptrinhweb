@model IEnumerable<SanPham>
<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Mô tả</th>
                <th>Hình ảnh</th>
                <th>Thể loại</th>
                <th>chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.price</td>
                    <td><img src="@item.ImageUrl" width="50%"</td>
                    <td>@item.TheLoai.Name</td>
                    <td>
                        <a asp-action="Upsert" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details">Details</a>
                        <a asp-action="Delete" onclick="xoa(@item.Id,$(this))">Delete</a>
                    </td>
                </tr>
            }
            <script>
                function confirDelete(id, row) { 
                    if (confirm(" bạn có chắc chắn muốn xoá")) {
                        xoa(id, $(row))
                    }
                    function xoa(idx, row) {
                        $.ajax({
                            url: 'SanPham/Delete',
                            type: 'POST'
                            data: { id: idx }
                            success: function (data) {
                                if (data.success) {
                                    // nếu xoá thành công, xoá dòng trong bản
                                    row.closest("tr").remove();
                                } else {
                                    // nếu có lỗi từ server, hiển thị thông báo lỗi
                                    alert(data.message);
                                }
                            }
                            Error: function (xhr, status, error) {
                                // xử lý lỗi khi ajax gặp sự cố
                                alert("xoá thất bại" + error);
                            }
                        })
                    }
            </script>

